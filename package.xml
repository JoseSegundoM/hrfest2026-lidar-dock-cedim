<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cedim_dock</name>
  <version>1.0.0</version>
  <description>
    Docking autonomo del iRobot Create 3 guiado unicamente por LiDAR.
    Solucion del equipo CEDIM para el LiDAR Perception Challenge (HRFEST 2026).
    El dock se estima como un landmark estatico en el frame odom a partir de la
    firma geometrica de las dos cajas marcadoras, lo que permite ejecutar el
    tramo final de aproximacion cuando el marcador deja de ser resoluble.
  </description>
  <maintainer email="JoseSegundoM@users.noreply.github.com">Equipo CEDIM</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>irobot_create_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
